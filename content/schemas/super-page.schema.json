{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundlessagentlabs.github.io/seo-bloger-agent/schemas/super-page.schema.json",
  "title": "SEO Super Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "brief",
    "metadata",
    "hero",
    "toc",
    "sections",
    "faq",
    "internalLinks",
    "imageSlots",
    "breadcrumbs",
    "qualityGates"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword", "intent", "audience", "angle", "sourceModel"],
      "properties": {
        "keyword": { "type": "string", "minLength": 2 },
        "intent": { "enum": ["informational", "commercial", "transactional", "navigational", "mixed"] },
        "audience": { "type": "string", "minLength": 4 },
        "angle": { "type": "string", "minLength": 8 },
        "sourceModel": { "type": "string", "minLength": 2 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "canonicalUrl", "updatedAt", "author", "openGraph"],
      "properties": {
        "title": { "type": "string", "minLength": 12, "maxLength": 70 },
        "description": { "type": "string", "minLength": 40, "maxLength": 170 },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "updatedAt": { "type": "string", "format": "date" },
        "author": { "type": "string", "minLength": 2 },
        "openGraph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "image"],
          "properties": {
            "title": { "type": "string", "minLength": 8 },
            "description": { "type": "string", "minLength": 24 },
            "image": { "type": "string", "minLength": 4 }
          }
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "answer", "summaryBullets", "trustCue"],
      "properties": {
        "headline": { "type": "string", "minLength": 8 },
        "answer": { "type": "string", "minLength": 80 },
        "summaryBullets": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 8 } },
        "trustCue": { "type": "string", "minLength": 10 }
      }
    },
    "toc": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 4 }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/section" }
    },
    "faq": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "minLength": 12 },
          "answer": { "type": "string", "minLength": 30 }
        }
      }
    },
    "internalLinks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor", "href", "purpose"],
        "properties": {
          "anchor": { "type": "string", "minLength": 4 },
          "href": { "type": "string", "pattern": "^/" },
          "purpose": { "type": "string", "minLength": 8 }
        }
      }
    },
    "imageSlots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/imageSlot" }
    },
    "breadcrumbs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "href"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "href": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "qualityGates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "severity", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 4 },
          "status": { "enum": ["pass", "warn", "fail"] },
          "severity": { "enum": ["low", "medium", "high"] },
          "evidence": { "type": "string", "minLength": 8 }
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "heading", "searchIntent", "summaryClaim", "paragraphs", "examples", "caveats", "imageSlotId", "qualityNotes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "heading": { "type": "string", "minLength": 6 },
        "searchIntent": { "type": "string", "minLength": 8 },
        "summaryClaim": { "type": "string", "minLength": 20 },
        "paragraphs": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 80 } },
        "examples": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 20 } },
        "caveats": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 20 } },
        "imageSlotId": { "type": "string", "minLength": 3 },
        "qualityNotes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } }
      }
    },
    "imageSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "purpose", "prompt", "alt", "caption", "provider", "status", "qa"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["hero", "section", "diagram", "comparison"] },
        "purpose": { "type": "string", "minLength": 10 },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "context", "composition", "realismConstraints", "avoid"],
          "properties": {
            "subject": { "type": "string", "minLength": 8 },
            "context": { "type": "string", "minLength": 12 },
            "composition": { "type": "string", "minLength": 10 },
            "realismConstraints": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 6 } },
            "avoid": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 4 } }
          }
        },
        "alt": { "type": "string", "minLength": 18 },
        "caption": { "type": "string", "minLength": 18 },
        "provider": { "type": "string", "minLength": 3 },
        "status": { "enum": ["planned", "generated", "needs-regeneration", "mock"] },
        "assetPath": { "type": "string" },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relevance", "textArtifacts", "realism", "notes"],
          "properties": {
            "relevance": { "enum": ["pass", "warn", "fail"] },
            "textArtifacts": { "enum": ["pass", "warn", "fail"] },
            "realism": { "enum": ["pass", "warn", "fail"] },
            "notes": { "type": "string", "minLength": 8 }
          }
        }
      }
    }
  }
}

# Copy values from your local private environment; never commit real secrets.

# Text model routing used by src/models/gateway.ts
AI_PROVIDER=openai-compatible
AI_MODEL=codex5.5pro
AI_BASE_URL=
AI_API_KEY=
AI_LIVE=false

# Image model routing used by src/images/adapter.ts
IMAGE_AI_PROVIDER=codex-imagen2api
IMAGE_AI_MODEL=gpt-image-2
IMAGE_AI_BASE_URL=
IMAGE_AI_API_KEY=
CODEX_IMAGEN2_API_BASE_URL=http://127.0.0.1:8000

# Optional provider aliases
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=

# App origin for future API callbacks / preview URLs
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
DATABASE_URL=
